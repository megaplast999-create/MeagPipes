# Mega Pipes Quotation System - Environment Configuration Template
# Copy this file to .env and provide environment-specific values.
# NEVER commit .env to version control.

# Application Environment: development | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL Connection URL
# Example (Local): postgresql://user:password@localhost:5432/megapipes
# Example (Render): postgresql://megapipes_user:secret@dpg-xxxx.render.com/megapipes
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/megapipes

# Redis Connection URL
# Example: redis://localhost:6379/0
# Example (Render): rediss://red-xxxx:secret@oregon-redis.render.com:6379
REDIS_URL=redis://localhost:6379/0

# Security & Session Signing
# Generate a cryptographically secure random string with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-insecure-default-key-generate-a-strong-random-secret

# Session Lifetimes (minutes / hours)
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_LIFETIME_HOURS=8

# Allowed CORS Origins (JSON list or comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Trusted Proxies (Comma-separated IP addresses or subnets allowed in X-Forwarded-For)
TRUSTED_PROXIES=127.0.0.1,::1

# Rate Limiting (Requests per minute per IP / session)
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_CALCULATE_PER_MINUTE=30
RATE_LIMIT_EXPORT_PER_MINUTE=20

# Pilot User Provisioning (Optional initial admin/pilot user seed)
PILOT_USER_EMAIL=pilot@megapipes.internal
PILOT_USER_PASSWORD_HASH=
PILOT_USER_FULL_NAME=Mega Pipes Pilot User
